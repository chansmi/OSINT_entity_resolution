# Required for API-based baselines. The paper's runs used a LiteLLM proxy
# (OpenAI-compatible) so one client reaches OpenAI and Anthropic models;
# leave OPENAI_BASE_URL empty to call OpenAI directly (openai/* models only).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: experiment tracking
WANDB_API_KEY=

# Optional: Hugging Face model access
HF_TOKEN=

# Optional: local model paths (defaults to ./models/pretrained and ./checkpoints)
PRETRAINED_MODELS_DIR=
CHECKPOINTS_DIR=
